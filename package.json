{
  "name": "mrikipos",
  "version": "0.1.0",
  "private": true,
  "description": "Kasir digital berbasis web (PWA) untuk UMKM Kota Blitar",
  "author": "MrikiPOS Team",
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:routes": "node scripts/verify-built-routes.mjs && node scripts/verify-route-guard.mjs",
    "test:entrypoints": "node scripts/verify-workspace-entrypoints.mjs",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:generate": "pnpm --filter api db:generate",
    "db:migrate": "pnpm --filter api db:migrate",
    "db:push": "pnpm --filter api db:push",
    "db:studio": "pnpm --filter api db:studio"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.4.4",
    "typescript": "^5.7.3"
  }
}
